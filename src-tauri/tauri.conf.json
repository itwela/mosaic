{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mosaic",
  "version": "0.2.2",
  "identifier": "com.itwelaibomu.mosaic",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "mosaic",
        "width": 1280,
        "height": 800,
        "minWidth": 390,
        "minHeight": 500,
        "decorations": true,
        "maximizable": false,
        "fullscreen": false,
        "transparent": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 24
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "infoPlist": "Info.plist",
      "minimumSystemVersion": "13.0",
      "entitlements": "Entitlements.plist"
    },
    "externalBin": [
      "binaries/mosaic-voice"
    ]
  }
}
